# MongoDB Atlas connection string (free M0 cluster works fine)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/learnhub

# Optional: secret used to sign JWTs. If omitted, one is derived from MONGODB_URI.
JWT_SECRET=

# Optional: protects the daily demo-reset cron endpoint (Vercel sends it automatically)
CRON_SECRET=

# Local API port (used by `npm run dev:api` / Docker only)
PORT=5000
